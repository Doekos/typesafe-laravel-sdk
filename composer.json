{
    "name": "doekos/typesafe-laravel-sdk",
    "description": "Laravel-native SDK for the TypeSafe (Jev / System One) API.",
    "keywords": ["laravel", "typesafe", "jev", "system-one", "sdk", "ai"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Doekos\\TypeSafe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doekos\\TypeSafe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Doekos\\TypeSafe\\TypeSafeServiceProvider"
            ],
            "aliases": {
                "TypeSafe": "Doekos\\TypeSafe\\Facades\\TypeSafe"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
